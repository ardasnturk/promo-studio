    "%@ is too old. Node.js %lld or later is required.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist zu alt. Node.js %lld oder neuer ist erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es demasiado antiguo. Se necesita Node.js %lld o posterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est trop ancien. Node.js %lld ou version ultérieure est requis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è troppo vecchio. È richiesto Node.js %lld o versioni successive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は古すぎます。Node.js %lld以降が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 너무 오래된 버전입니다. Node.js %2$lld 이상이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é muito antigo. É necessário o Node.js %lld ou posterior."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ çok eski. Node.js %lld veya üstü gerekiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 版本过旧。需要 Node.js %lld 或更高版本。"
          }
        }
      }
    },
