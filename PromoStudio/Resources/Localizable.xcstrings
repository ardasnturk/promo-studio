    "Compositions with a schema can be re-rendered by editing their parameters in the studio, without changing any code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompositionen mit Schema können neu gerendert werden, indem du ihre Parameter im Studio bearbeitest – ganz ohne Codeänderung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las composiciones con un esquema se pueden volver a renderizar editando sus parámetros en el estudio, sin cambiar código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les compositions dotées d’un schéma peuvent être rendues à nouveau en modifiant leurs paramètres dans le studio, sans toucher au code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le composizioni con uno schema possono essere renderizzate di nuovo modificandone i parametri nello studio, senza cambiare il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキーマを持つコンポジションは、コードを変更せずにスタジオでパラメータを編集して再レンダリングできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스키마가 있는 컴포지션은 코드를 변경하지 않고 스튜디오에서 매개변수를 편집하여 다시 렌더링할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As composições com um schema podem ser renderizadas novamente editando os parâmetros no estúdio, sem alterar nenhum código."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şemalı kompozisyonlar, stüdyoda parametreleri düzenlenerek kod değiştirmeden yeniden render edilebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带有 schema 的合成可以在工作室中编辑其参数后重新渲染，无需更改任何代码。"
          }
        }
      }
    },
