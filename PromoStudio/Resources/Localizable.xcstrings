    "Produce without voiceover (e.g. if the Gemini quota is used up); scene durations come from the storyboard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Voice-over produzieren (z. B. wenn das Gemini-Kontingent aufgebraucht ist); die Szenendauern stammen aus dem Storyboard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Producir sin locución (p. ej., si se ha agotado la cuota de Gemini); la duración de las escenas sale del guion gráfico"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Produire sans voix off (par ex. si le quota Gemini est épuisé) ; la durée des scènes provient du storyboard"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Produci senza voce narrante (ad es. se la quota Gemini è esaurita); la durata delle scene viene dallo storyboard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナレーションなしで制作（例：Geminiの割り当てを使い切った場合）。シーンの長さは絵コンテに基づきます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내레이션 없이 제작(예: Gemini 할당량을 모두 사용한 경우). 장면 길이는 스토리보드를 따름"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Produzir sem narração (ex.: se a cota do Gemini tiver acabado); a duração das cenas vem do storyboard"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seslendirme olmadan üret (ör. Gemini kotası dolduysa); sahne süreleri storyboard'dan alınır"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不带配音制作（例如 Gemini 配额已用完时）；场景时长取自分镜"
          }
        }
      }
    },
