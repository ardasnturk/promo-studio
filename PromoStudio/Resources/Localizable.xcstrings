    "For publishing. Without it, save videos and post them yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Veröffentlichen. Ohne Konto sicherst du Videos und postest sie selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para publicar. Sin ella, guarda los vídeos y publícalos tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour publier. Sans cela, enregistrez les vidéos et publiez-les vous-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per pubblicare. Senza, salva i video e pubblicali tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開用です。なくても、動画を保存して自分で投稿できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시용입니다. 없으면 동영상을 저장하고 직접 게시하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para publicar. Sem isso, salve os vídeos e publique-os você mesmo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım için. Bağlamadan da videoları kaydedip kendin paylaşabilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于发布。没有它时，请存储视频并自行发布。"
          }
        }
      }
    },
    "For voiceover. Videos can be made without it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das Voice-over. Videos gehen auch ohne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para la locución. Los vídeos se pueden hacer sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour la voix off. Les vidéos peuvent être créées sans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la voce narrante. I video si possono creare anche senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナレーション用です。なくても動画は作成できます。"
