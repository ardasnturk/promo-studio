// Default: ad-hoc signing (anyone can build). Because the ad-hoc signature changes on every build,
// Keychain does not remember "Always Allow". To sign with your own developer identity, create
// Config/Signing.local.xcconfig (ignored by git):
//
//     DEVELOPMENT_TEAM = <TEAM_ID>
//     CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
#include? "Signing.local.xcconfig"
