    "Analysis and text generation run in the background with the `claude` CLI on your Mac (using your own session).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse und Textgenerierung laufen im Hintergrund mit der `claude`-CLI auf deinem Mac (mit deiner eigenen Sitzung)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis y la generación de texto se ejecutan en segundo plano con la CLI `claude` en tu Mac (con tu propia sesión)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse et la génération de texte s’exécutent en arrière-plan avec la CLI `claude` sur votre Mac (avec votre propre session)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi e la generazione del testo vengono eseguite in background con la CLI `claude` sul tuo Mac (con la tua sessione)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分析とテキスト生成は、Macの`claude` CLIを使ってバックグラウンドで実行されます（あなた自身のセッションを使用）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
