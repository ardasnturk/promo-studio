    "%@ already exists. To add the library from there, use \"Add Library…\", or choose another folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereits vorhanden. Um die Bibliothek von dort hinzuzufügen, verwende „Bibliothek hinzufügen …“, oder wähle einen anderen Ordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya existe. Para añadir la biblioteca desde ahí, usa “Añadir biblioteca…” o elige otra carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe déjà. Pour ajouter la bibliothèque depuis cet emplacement, utilisez “Ajouter une bibliothèque…”, ou choisissez un autre dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esiste già. Per aggiungere la libreria da lì, usa “Aggiungi libreria…” oppure scegli un’altra cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はすでに存在します。そこからライブラリを追加するには「ライブラリを追加…」を使用するか、別のフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이미 있습니다. 해당 위치의 라이브러리를 추가하려면 ‘라이브러리 추가…’를 사용하거나 다른 폴더를 선택하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já existe. Para adicionar a biblioteca a partir dali, use “Adicionar Biblioteca…” ou escolha outra pasta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zaten var. Kütüphaneyi oradan eklemek için \"Kütüphane ekle…\"yi kullan ya da başka bir klasör seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已存在。若要从那里添加库，请使用“添加库…”，或选择其他文件夹。"
          }
        }
      }
    },
