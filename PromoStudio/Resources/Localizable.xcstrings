    "GitHub is rate-limiting update checks right now. Try again in an hour.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub begrenzt gerade die Update-Abfragen. Versuche es in einer Stunde erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub está limitando las comprobaciones de actualizaciones. Vuelve a intentarlo dentro de una hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub limite actuellement les recherches de mises à jour. Réessayez dans une heure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub sta limitando i controlli degli aggiornamenti. Riprova tra un’ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、GitHubによりアップデートの確認が制限されています。1時間後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 GitHub에서 업데이트 확인을 제한하고 있습니다. 한 시간 후에 다시 시도하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub está limitando as verificações de atualização no momento. Tente novamente em uma hora."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub şu an güncelleme denetimlerini sınırlıyor. Bir saat sonra tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 目前正在限制更新检查。请在一小时后重试。"
          }
        }
      }
    },
    "GitHub returned an error while downloading the update. Try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat beim Laden des Updates einen Fehler gemeldet. Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ha devuelto un error al descargar la actualización. Vuelve a intentarlo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a renvoyé une erreur lors du téléchargement de la mise à jour. Réessayez plus tard."
          }
        },
        "it": {
          "stringUnit": {
