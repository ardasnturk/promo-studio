    "“%@” has no linked Instagram account. Choose one from the header of the project screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat kein verknüpftes Instagram-Konto. Wähle eines in der Kopfzeile des Projektbildschirms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no tiene ninguna cuenta de Instagram vinculada. Elige una en la cabecera de la pantalla del proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” n’a aucun compte Instagram lié. Choisissez-en un dans l’en-tête de l’écran du projet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non ha un account Instagram collegato. Scegline uno dall’intestazione della schermata del progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」にはリンクされたInstagramアカウントがありません。プロジェクト画面のヘッダから選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’에 연결된 Instagram 계정이 없습니다. 프로젝트 화면의 헤더에서 계정을 선택하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não tem uma conta do Instagram vinculada. Escolha uma no cabeçalho da tela do projeto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” projesine bağlı bir Instagram hesabı yok. Proje ekranının başlığından hesap seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”没有关联的 Instagram 账户。请从项目屏幕的标题栏中选择一个。"
          }
        }
      }
