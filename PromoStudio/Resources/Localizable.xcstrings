    "macOS Gatekeeper rejected the update. Nothing was installed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Gatekeeper hat das Update abgelehnt. Es wurde nichts installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper de macOS ha rechazado la actualización. No se ha instalado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper de macOS a refusé la mise à jour. Rien n’a été installé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper di macOS ha rifiutato l’aggiornamento. Non è stato installato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSのGatekeeperがアップデートを拒否しました。何もインストールされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Gatekeeper가 업데이트를 거부했습니다. 아무것도 설치되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gatekeeper do macOS rejeitou a atualização. Nada foi instalado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Gatekeeper güncellemeyi reddetti. Hiçbir şey kurulmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 门禁拒绝了此更新。未安装任何内容。"
          }
        }
      }
    },
