    "No Instagram account is connected. Save the video and post it yourself, or connect an account in Account & Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Instagram-Konto verbunden. Sichere das Video und poste es selbst oder verbinde ein Konto unter Konto & Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna cuenta de Instagram conectada. Guarda el vídeo y publícalo tú mismo, o conecta una cuenta en Cuenta y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte Instagram n’est connecté. Enregistrez la vidéo et publiez-la vous-même, ou connectez un compte dans Compte et réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account Instagram collegato. Salva il video e pubblicalo tu, oppure collega un account in Account e impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagramアカウントが接続されていません。動画を保存して自分で投稿するか、「アカウントと設定」でアカウントを接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 Instagram 계정이 없습니다. 동영상을 저장하여 직접 게시하거나 계정 및 설정에서 계정을 연결하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta do Instagram está conectada. Salve o vídeo e publique-o você mesmo, ou conecte uma conta em Conta e Ajustes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı Instagram hesabı yok. Videoyu kaydedip kendin paylaşabilir ya da Hesap ve Ayarlar'dan bir hesap bağlayabilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接 Instagram 账户。请存储视频并自行发布，或在“账户与设置”中连接账户。"
          }
        }
      }
    },
