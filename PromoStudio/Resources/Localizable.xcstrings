    "No Gemini API key. Get one at aistudio.google.com and enter it here, or set the GEMINI_API_KEY environment variable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Gemini-API-Schlüssel. Hol dir einen auf aistudio.google.com und gib ihn hier ein oder setze die Umgebungsvariable GEMINI_API_KEY."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay clave de API de Gemini. Consigue una en aistudio.google.com e introdúcela aquí, o define la variable de entorno GEMINI_API_KEY."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé API Gemini. Obtenez-en une sur aistudio.google.com et saisissez-la ici, ou définissez la variable d’environnement GEMINI_API_KEY."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna chiave API Gemini. Ottienine una su aistudio.google.com e inseriscila qui, oppure imposta la variabile d’ambiente GEMINI_API_KEY."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini APIキーがありません。aistudio.google.comで取得してここに入力するか、GEMINI_API_KEY環境変数を設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini API 키가 없습니다. aistudio.google.com에서 키를 받아 여기에 입력하거나 GEMINI_API_KEY 환경 변수를 설정하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma chave de API do Gemini. Obtenha uma em aistudio.google.com e digite-a aqui, ou defina a variável de ambiente GEMINI_API_KEY."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini API anahtarı yok. aistudio.google.com'dan alıp buraya gir ya da GEMINI_API_KEY ortam değişkenini tanımla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 Gemini API 密钥。请在 aistudio.google.com 获取并在此输入，或设置 GEMINI_API_KEY 环境变量。"
          }
        }
      }
    },
