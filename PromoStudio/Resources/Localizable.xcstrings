    "Promo Studio can't replace itself in its current location. The download page has been opened in your browser.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Promo Studio kann sich an seinem aktuellen Ort nicht selbst ersetzen. Die Downloadseite wurde in deinem Browser geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Promo Studio no puede reemplazarse en su ubicación actual. Se ha abierto la página de descarga en tu navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promo Studio ne peut pas se remplacer à son emplacement actuel. La page de téléchargement a été ouverte dans votre navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promo Studio non può sostituirsi nella posizione attuale. La pagina di download è stata aperta nel browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Promo Studioは現在の場所で自身を置き換えることができません。ブラウザでダウンロードページを開きました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Promo Studio가 현재 위치에서 자신을 교체할 수 없습니다. 브라우저에서 다운로드 페이지가 열렸습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Promo Studio não pode se substituir no local atual. A página de download foi aberta no seu navegador."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promo Studio bulunduğu konumda kendini değiştiremiyor. İndirme sayfası tarayıcında açıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Promo Studio 无法在当前位置替换自身。已在浏览器中打开下载页面。"
          }
        }
      }
    },
