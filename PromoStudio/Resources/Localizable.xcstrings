          "stringUnit": {
            "state": "translated",
            "value": "ローカライズ版を探す対象の素の画面がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현지화된 버전을 찾을 원본 화면이 없습니다."
          }
        },
        "pt-BR": {
