    "%@ not found. Make sure it's installed and on your PATH.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nicht gefunden. Stelle sicher, dass es installiert und in deinem PATH ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no encontrado. Asegúrate de que está instalado y en tu PATH."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ introuvable. Vérifiez qu’il est installé et présent dans votre PATH."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non trovato. Assicurati che sia installato e nel tuo PATH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が見つかりません。インストールされていて、PATHに含まれていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 찾을 수 없습니다. 설치되어 있고 PATH에 포함되어 있는지 확인하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não encontrado. Verifique se está instalado e no seu PATH."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bulunamadı. Kurulu olduğundan ve PATH'te olduğundan emin olun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 %@。请确保已安装且位于 PATH 中。"
          }
        }
      }
    },
