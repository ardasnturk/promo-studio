            "value": "Es gibt keine Rohbildschirme, für die lokalisierte Versionen gesucht werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay pantallas sin marco de las que buscar versiones localizadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a aucun écran brut dont rechercher des versions localisées."
          }
        },
