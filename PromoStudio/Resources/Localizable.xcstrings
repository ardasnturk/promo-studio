        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートのダウンロード中にGitHubからエラーが返されました。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 다운로드하는 동안 GitHub에서 오류를 반환했습니다. 나중에 다시 시도하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
