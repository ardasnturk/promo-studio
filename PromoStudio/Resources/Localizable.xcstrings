    "Scheduled or published content can’t be revised. Unschedule it first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplante oder veröffentlichte Inhalte können nicht überarbeitet werden. Hebe zuerst die Planung auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido programado o publicado no se puede revisar. Primero cancela su programación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu programmé ou publié ne peut pas être révisé. Déprogrammez-le d’abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I contenuti pianificati o pubblicati non possono essere modificati. Prima annulla la pianificazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約済みまたは公開済みのコンテンツは修正できません。先に予約を解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약되었거나 게시된 콘텐츠는 수정할 수 없습니다. 먼저 예약을 취소하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteúdo agendado ou publicado não pode ser revisado. Cancele o agendamento primeiro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlanmış ya da paylaşılmış içerik revize edilemez. Önce zamanlamayı kaldır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已定时或已发布的内容无法修改。请先取消定时。"
          }
        }
      }
    },
    "Scheduled posts are published while Promo Studio is open (running in the menu bar also works).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplante Beiträge werden veröffentlicht, während Promo Studio geöffnet ist (auch in der Menüleiste)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones programadas se publican mientras Promo Studio está abierto (también sirve que se ejecute en la barra de menús)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publications programmées sont publiées tant que Promo Studio est ouvert (même dans la barre des menus)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I post pianificati vengono pubblicati mentre Promo Studio è aperto (va bene anche in esecuzione nella barra dei menu)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約投稿はPromo Studioが開いている間に公開されます（メニューバーで実行中でも構いません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약 게시물은 Promo Studio가 열려 있는 동안 게시됩니다(메뉴 막대에서 실행 중이어도 됩니다)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As publicações agendadas são publicadas enquanto o Promo Studio estiver aberto (funciona também na barra de menus)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlanmış paylaşımlar Promo Studio açıkken (menü çubuğunda da olur) gerçekleşir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时帖子会在 Promo Studio 打开时发布（在菜单栏中运行也可以）。"
          }
        }
      }
    },
