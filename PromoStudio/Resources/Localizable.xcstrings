    "Couldn't capture an image from the simulator. Make sure an iOS Simulator is running (booted).\n%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem Simulator konnte kein Bild aufgenommen werden. Stelle sicher, dass ein iOS-Simulator läuft (gestartet ist).\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido capturar una imagen del simulador. Asegúrate de que hay un Simulador de iOS en ejecución (arrancado).\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de capturer une image depuis le simulateur. Vérifiez qu’un simulateur iOS est en cours d’exécution (démarré).\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile acquisire un’immagine dal simulatore. Assicurati che un Simulatore iOS sia in esecuzione (avviato).\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータから画像をキャプチャできませんでした。iOSシミュレータが実行中（起動済み）であることを確認してください。\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터에서 이미지를 캡처할 수 없습니다. iOS 시뮬레이터가 실행 중(부팅됨)인지 확인하십시오.\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível capturar uma imagem do simulador. Verifique se há um Simulador do iOS em execução (iniciado).\n%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simülatörden görüntü alınamadı. Bir iOS Simülatörünün açık (booted) olduğundan emin olun.\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从模拟器截取图像。请确保 iOS 模拟器正在运行（已启动）。\n%@"
          }
        }
      }
    },
    "Couldn't copy the update from the disk image.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update konnte nicht aus dem Disk-Image kopiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido copiar la actualización desde la imagen de disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de copier la mise à jour depuis l’image disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile copiare l’aggiornamento dall’immagine disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクイメージからアップデートをコピーできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 이미지에서 업데이트를 복사할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível copiar a atualização da imagem de disco."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme disk görüntüsünden kopyalanamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从磁盘映像中拷贝更新。"
          }
        }
      }
    },
